# Configuração de produção — versionada de propósito: o deploy não depende de
# variáveis cadastradas no painel. Repositório PRIVADO: se ele voltar a ser
# público, troque a senha do banco e o SESSION_SECRET antes.
#
# Este arquivo é copiado para dentro de .next/standalone pelo `postbuild`, que é
# de onde o servidor standalone lê o ambiente.

DATABASE_URL=postgres://app-jh7:7rmdcChWhxntBcbj@216.22.31.131:5432/app-jh7

SESSION_SECRET=idTYWLyHH3iWZ8h1weHxoGRlVt1AUf/Z5SqbFcdESbA=

# Sem usuários no banco, o primeiro boot cria este administrador.
ADMIN_NAME=João Hueder
