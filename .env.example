# Pasta dos dados: banco e uploads. Em produção aponte para FORA da pasta do
# código (ex.: /data no container, /var/lib/jh7 no servidor), senão cada
# atualização leva os dados junto. Sem DATA_DIR, usa ./data ao lado do código.
DATA_DIR=

# Caminho do arquivo SQLite. Opcional: sem ele, DATA_DIR/jh7.db.
DB_PATH=

# Segredo para assinar o cookie de sessão (32+ bytes aleatórios)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Administrador criado no primeiro boot, quando o banco ainda não tem usuários.
# Depois disso o valor é ignorado — troque a senha pelo próprio sistema.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Porta e interface do servidor standalone (padrão 3000 / 0.0.0.0).
# O painel costuma preencher PORT sozinho.
# PORT=3000
# HOSTNAME=0.0.0.0