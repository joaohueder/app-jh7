# Postgres. Em produção aponte para o banco gerenciado; sem a variável o app
# cai no Postgres local do docker-compose (127.0.0.1:55432).
# Formato: postgres://usuario:senha@host:porta/banco
DATABASE_URL=

# Segredo para assinar o cookie de sessão (32+ bytes aleatórios)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Administrador criado no primeiro boot, quando ainda não há usuários.
# Depois disso o valor é ignorado — troque a senha pelo próprio sistema.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Pasta dos uploads (logos). Em container aponte para o volume: /data.
# Sem a variável, usa ./data/uploads ao lado do código.
DATA_DIR=

# Porta e interface do servidor standalone (padrão 3000 / 0.0.0.0).
# PORT=3000
# HOSTNAME=0.0.0.0